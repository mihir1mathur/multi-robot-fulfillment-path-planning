# Copy to .env and fill in real values. .env is git-ignored - never commit it.
# .env.example holds placeholders ONLY, never real secrets.

# --- database ---------------------------------------------------------
# SQLAlchemy URL. Production target is PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
# Local dev without a server can use SQLite:
#   DATABASE_URL=sqlite+pysqlite:///./fulfillment.db
DATABASE_URL=postgresql+psycopg://fulfillment:CHANGE_ME@localhost:5432/fulfillment

# Optional: a separate PostgreSQL database used ONLY by
# tests/test_postgres_integration.py. When unset, those tests skip.
TEST_DATABASE_URL=postgresql+psycopg://fulfillment:CHANGE_ME@localhost:5432/fulfillment_test

# false = Alembic owns the schema (run `alembic upgrade head` first).
# true  = the app runs create_all on startup (dev / SQLite convenience).
AUTO_CREATE_TABLES=true

# --- authentication --------------------------------------------------
# HMAC signing key for JWT access tokens. MUST be a long random string in any
# real environment. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: if BOTH are set and the users table is empty, the app creates one
# admin at startup so a fresh database is never locked out. Leave unset
# otherwise.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- misc ------------------------------------------------------------
LOG_LEVEL=INFO
SQL_ECHO=false
APP_NAME=fulfillment-api

# --- docker compose only (not read by the app) ---------------------
POSTGRES_USER=fulfillment
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=fulfillment
API_PORT=8000
